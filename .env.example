# Servidor
PORT=3000

# Notificaciones por mail
# Para Gmail: MAIL_PASS debe ser una App Password (https://myaccount.google.com/apppasswords)
# MAIL_HOST y MAIL_PORT son opcionales; por defecto usa smtp.gmail.com:587
MAIL_USER=tu@gmail.com
MAIL_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_TO=destinatario@ejemplo.com
MAIL_HOST=
MAIL_PORT=

# Hora de envío diario (0-23, por defecto 9 = 9:00 AM Argentina)
NOTIF_HORA=9

# ARCA (ex AFIP)
# CUIT del contribuyente (sin guiones)
CUIT=
# Punto de venta habilitado en ARCA (ver Comprobantes en Línea → Administración de puntos de venta)
PUNTO_VENTA=
# Tipo de comprobante:
#   1  = Factura A
#   2  = Nota de Débito A
#   3  = Nota de Crédito A
#   6  = Factura B
#   7  = Nota de Débito B
#   8  = Nota de Crédito B
#  19  = Factura de Exportación E
# 201  = Factura Crédito Electrónica MiPyMEs FCE A
TIPO_COMPROBANTE=
